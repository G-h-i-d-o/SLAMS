VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
ITSM_API=https://itsm.internal/api/v1
ITSM_TOKEN=REPLACE_ME
SUPABASE_ACCESS_TOKEN=YOUR-CLI-ACCESS-TOKEN
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# ── Sentry (Phase 8) ───────────────────────────────────────────
# Leave blank to disable Sentry entirely. No signup needed for local dev.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# ── Cloudflare Turnstile (optional) ────────────────────────────
# Leave blank to disable. Widget appears only when both keys are set.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=