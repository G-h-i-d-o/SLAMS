# ── Frontend (Vite — exposed to browser) ────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Netlify Functions & CI only (NEVER exposed to browser) ──────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── ITSM integration (Phase 4) ──────────────────────────────────
ITSM_API=https://itsm.internal/api/v1
ITSM_TOKEN=REPLACE_ME

# ── Supabase CLI (local dev + CI) ───────────────────────────────
SUPABASE_ACCESS_TOKEN=YOUR-CLI-ACCESS-TOKEN
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
